---
# Replace the three addresses. Names can stay as they are — the roles use them.
all:
  children:

    cluster:
      hosts:
        node1:
          ansible_host: 172.16.7.11   # node1 management address
        node2:
          ansible_host: 172.16.7.12   # node2 management address
      vars:
        ansible_user: root

    # A third machine, off the pair, holding the deciding quorum vote.
    # Small: 1 vCPU and 1 GB is enough. It must NOT be one of the two nodes.
    arbiter:
      hosts:
        qnetd1:
          ansible_host: 172.16.7.20   # arbiter management address
      vars:
        ansible_user: root
