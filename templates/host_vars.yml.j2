---
# {{ inventory_hostname }} — generated by playbooks/01-discover.yml
#
# Everything here is pinned to an identifier that CANNOT change across reboots,
# firmware updates or drive swaps. Kernel names appear only as comments.

node_name: {{ inventory_hostname }}
node_id: {{ 1 if inventory_hostname == node1_name else 2 }}

# ── Management / ring0 ──────────────────────────────────────────────────────
# Bound by MAC. NetworkManager binds the connection to the adapter, not to a
# name, so this survives the interface being renamed.
control_mac: "{{ _mgmt.mac | default('') }}"
control_nic: "{{ _mgmt.name | default('') }}"        # current name, reference only
lan_ip: {{ ansible_default_ipv4.address }}

# ── Storage / replication / ring1 ───────────────────────────────────────────
{% if _repl.mac is defined and _repl.mac | length > 0 %}
repl_mac: "{{ _repl.mac }}"
repl_nic: "{{ _repl.name }}"                         # current name, reference only
{% else %}
# NO SECOND PHYSICAL NIC FOUND.
# Either fit one, or set repl_vlan_id in group_vars to tag the storage VLAN onto
# the management interface — and set repl_mac to control_mac below.
repl_mac: ""
repl_nic: ""
{% endif %}
repl_ip: {{ '172.18.8.10' if inventory_hostname == node1_name else '172.18.8.11' }}

# ── Storage device ──────────────────────────────────────────────────────────
# by-id, so a controller reorder or an added drive cannot repoint this at the
# wrong disk. NEVER replace this with /dev/nvmeXn1 or /dev/sdX.
#
#   selected : {{ _storage.kernel | default('?') }}  {{ _storage.size | default('') }}  {{ _storage.model | default('') }}
{% for d in _disk %}
#   {{ 'in use ' if d.free != 'yes' else 'free   ' }} {{ '%-8s' | format(d.kernel) }} {{ '%-8s' | format(d.size) }} {{ d.byid }}
{% endfor %}
# Not consumed by any role — the installer's %pre picks the OS disk itself.
# Recorded so the choice can be verified against /root/disk-layout.log, and so
# a replaced drive is obvious.
os_device: "{{ _os.byid | default('') }}"

storage_device: "{{ _storage.byid | default('') }}"

# ── Fencing ─────────────────────────────────────────────────────────────────
{% if _bmc.stdout %}
redfish_address: "{{ _bmc.stdout }}"
{% else %}
# BMC not visible from the OS. Read it from firmware and set it here.
redfish_address: ""
{% endif %}

# Lab fallback only.
switch_port: {{ 'ether2' if inventory_hostname == node1_name else 'ether3' }}
